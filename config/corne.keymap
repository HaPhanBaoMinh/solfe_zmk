/* Corne 3x6 keymap for Neovim, which-key/Hints and tmux. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer { if-layers = <LOWER RAISE>; then-layer = <ADJUST>; };
    };

    macros {
        tmux_leader: tmux_leader { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE)>; };
        tmux_group_split: tmux_group_split { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp S>; };
        tmux_group_windows: tmux_group_windows { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp W>; };
        tmux_group_panes: tmux_group_panes { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp P>; };
        tmux_group_sessions: tmux_group_sessions { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(SPACE) &kp T>; };
        nvim_group_action: nvim_group_action { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SPACE &kp A>; };
        nvim_group_split: nvim_group_split { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SPACE &kp S>; };
        nvim_group_find: nvim_group_find { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SPACE &kp F>; };
        nvim_group_git: nvim_group_git { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SPACE &kp G>; };
        nvim_group_term: nvim_group_term { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SPACE &kp T>; };
        nvim_toggle_tree: nvim_toggle_tree { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SPACE &kp E>; };
        hunt_and_pick: hunt_and_pick { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(SPACE)>; };
        nvim_save: nvim_save { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(S)>; };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "default";
            bindings = <
                &kp ESC &kp Q &kp W &kp E &kp R &kp T
                &kp Y &kp U &kp I &kp O &kp P &kp BACKSPACE
                &kp TAB &kp A &kp S &kp D &kp F &kp G
                &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                &kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RIGHT_SHIFT
                &kp LCTRL &kp LALT &mo LOWER &mo RAISE &kp SPACE &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp PG_UP PG_DN>;
        };
        lower_layer {
            display-name = "lower";
            bindings = <
                &kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5
                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
                &kp TILDE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
                &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp F12
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET
                &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp UNDER &kp PIPE
                &none &none &none &none &none &none
            >;
        };
        raise_layer {
            display-name = "raise";
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &kp INS &kp PSCR &kp HOME &kp END &kp PG_UP &kp PG_DN
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL &kp BACKSPACE
                &nvim_save &nvim_group_action &nvim_group_split &nvim_group_find &nvim_group_git &nvim_group_term
                &nvim_toggle_tree &hunt_and_pick &tmux_leader &tmux_group_split &tmux_group_windows &tmux_group_panes
                &tmux_group_sessions &none &none &none &none &none
                &none &none &none &none &none &none
            >;
        };
        adjust_layer {
            display-name = "adjust";
            bindings = <
                &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none &none &none
            >;
        };
    };
};
